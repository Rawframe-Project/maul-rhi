//
// The storage container's compute entry "cs": reads a read-only storage
// buffer, writes each value doubled plus one to a storage buffer and
// each value over 255 to a row of a write-only storage texture.

#version 450

layout(local_size_x = 4, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Inputs
{
    uint values[];
} inputs;

layout(set = 0, binding = 1) buffer Outputs
{
    uint values[];
} outputs;

layout(set = 0, binding = 2, rgba8) writeonly uniform image2D image;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    uint value = inputs.values[i];
    outputs.values[i] = value * 2u + 1u;
    imageStore(image, ivec2(int(i), 0), vec4(float(value) / 255.0, 0.0, 0.0, 1.0));
}
