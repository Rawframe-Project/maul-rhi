//
// The f16 container's compute entry "cs" (shaderF16): reads pairs of
// 16-bit floats from a buffer of them and writes each pair's product
// plus a half as a 16-bit float, every value exact in 16 bits, so the
// buffers' two-byte layout and the arithmetic are what is checked.

#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 4, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Inputs
{
    float16_t values[];
} inputs;

layout(set = 0, binding = 1) buffer Outputs
{
    float16_t values[];
} outputs;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    outputs.values[i] = inputs.values[i * 2u] * inputs.values[i * 2u + 1u] + float16_t(0.5);
}
