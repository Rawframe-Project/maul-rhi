//
// The conformance container's compute entry "cs": scales a storage
// buffer in table 0 by a specialization constant.

#version 450

layout(constant_id = 0) const uint scale = 1u;

layout(local_size_x = 8, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 1) buffer Data
{
    uint values[];
} data;

void main()
{
    data.values[gl_GlobalInvocationID.x] *= scale;
}
