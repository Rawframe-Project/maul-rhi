//
// The lone_table container's compute entry "cs": writes 1 to a storage
// buffer bound in table 1, the only table it reads.

#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 1, binding = 0) buffer Words
{
    uint values[];
} words;

void main()
{
    words.values[0] = 1u;
}
