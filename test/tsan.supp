# ThreadSanitizer suppressions for the conformance suite (mrhi-0003).
# Lavapipe runs its rasterizer on threads of its own, compiles shaders
# with LLVM and presents through the XCB client library, all built
# without ThreadSanitizer, which cannot see how they order their
# threads and locks; they are not the driver's to check.
called_from_lib:libvulkan_lvp.so
called_from_lib:libLLVM
called_from_lib:libxcb.so
