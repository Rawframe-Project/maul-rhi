//
// The compute sample's squaring entry "square": each invocation below
// the root block's count writes the square of its index.

#version 450

layout(push_constant) uniform Root
{
    uint count;
} root;

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Values
{
    uint values[];
} data;

void main()
{
    uint index = gl_GlobalInvocationID.x;
    if (index < root.count)
    {
        data.values[index] = index * index;
    }
}
